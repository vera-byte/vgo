# vgo 环境变量模板
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，严禁提交）。
# 本地开发可直接使用下列非敏感默认值；生产环境必须更换全部密钥并完成泄露凭证轮换。

# PostgreSQL 业务库密码
VGO_DB_PASS=your_db_password

# Redis 密码
VGO_REDIS_PASS=your_redis_password

# 对象存储（minio/oss）访问凭证
VGO_OSS_ACCESS_KEY_ID=your_access_key_id
VGO_OSS_SECRET_ACCESS_KEY=your_secret_access_key

# docker-compose 本地开发用（make mysql-up / pgsql-up / redis-up）
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PASSWORD=your_mysql_password
POSTGRES_PASSWORD=your_postgres_password   # 应与 VGO_DB_PASS 一致
